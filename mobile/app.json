{
  "expo": {
    "name": "LowP - Real-Time Grocery Price Comparator",
    "slug": "lowp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/loop-bag-logo.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/loop-bag-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F8FAFC"
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lowp.app"
    },
    "android": {
      "package": "com.lowp.app",
      "adaptiveIcon": {
        "backgroundColor": "#F8FAFC",
        "foregroundImage": "./assets/loop-bag-logo.png",
        "monochromeImage": "./assets/loop-bag-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/loop-bag-logo.png"
    },
    "extra": {
      "eas": {
        "projectId": "fc1bce65-e90d-4ace-89fc-2444e98f3edd"
      }
    },
    "description": "Hunt the lowest price with privacy"
  }
}
