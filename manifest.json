{
  "manifest_version": 3,
  "name": "LowP - Hunt the lowest price with privacy",
  "short_name": "LowP",
  "version": "2.0.0",
  "description": "Hunt the lowest price with privacy. Compare groceries across six stores, build a basket and apply your card discounts and cashback offers.",
  "permissions": [
    "storage",
    "alarms",
    "cookies",
    "tabs",
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "src/popup/popup.html"
  },
  "host_permissions": [
    "*://*.amazon.in/*",
    "*://*.swiggy.com/*",
    "*://*.zepto.com/*",
    "*://*.zeptonow.com/*",
    "*://*.blinkit.com/*",
    "*://*.flipkart.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_title": "Open LowP side panel",
    "default_icon": {
      "16": "assets/loop-bag-logo.png",
      "48": "assets/loop-bag-logo.png",
      "128": "assets/loop-bag-logo.png"
    }
  },
  "options_page": "src/options/options.html",
  "icons": {
    "16": "assets/loop-bag-logo.png",
    "48": "assets/loop-bag-logo.png",
    "128": "assets/loop-bag-logo.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.in/*",
        "*://*.swiggy.com/*",
        "*://*.zepto.com/*",
        "*://*.zeptonow.com/*",
        "*://*.blinkit.com/*",
        "*://*.flipkart.com/*"
      ],
      "js": [
        "src/content/content-script.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
