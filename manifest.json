{
  "manifest_version": 3,
  "name": "LowP - Real-Time Price Comparator (Amazon, Instamart, Zepto)",
  "short_name": "LowP",
  "version": "2.0.0",
  "description": "Hyperlocal real-time price comparison across Amazon India, Swiggy Instamart, and Zepto with live in-browser synchronization.",
  "permissions": [
    "storage",
    "alarms",
    "cookies",
    "tabs",
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "src/popup/popup.html"
  },
  "host_permissions": [
    "*://*.amazon.in/*",
    "*://*.swiggy.com/*",
    "*://*.zepto.com/*",
    "*://*.zeptonow.com/*",
    "*://*.blinkit.com/*",
    "*://*.flipkart.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_title": "Open LowP side panel",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "options_page": "src/options/options.html",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.in/*",
        "*://*.swiggy.com/*",
        "*://*.zepto.com/*",
        "*://*.zeptonow.com/*",
        "*://*.blinkit.com/*",
        "*://*.flipkart.com/*"
      ],
      "js": ["src/content/content-script.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
