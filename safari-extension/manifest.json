{
  "manifest_version": 3,
  "name": "LowP - Quick Commerce Price Comparator",
  "version": "2.0.0",
  "description": "Real-time grocery price comparator across Amazon Now (Tez), Swiggy Instamart, Zepto, and Blinkit for Safari.",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "LowP - Compare Grocery Prices",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "cookies"
  ],
  "host_permissions": [
    "*://*.amazon.in/*",
    "*://*.swiggy.com/*",
    "*://*.zepto.com/*",
    "*://*.zeptonow.com/*",
    "*://*.blinkit.com/*",
    "*://*.flipkart.com/*",
    "*://*.nominatim.openstreetmap.org/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.in/*",
        "*://*.swiggy.com/*",
        "*://*.zepto.com/*",
        "*://*.zeptonow.com/*",
        "*://*.blinkit.com/*",
        "*://*.flipkart.com/*"
      ],
      "js": ["src/content/content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": false
  }
}
